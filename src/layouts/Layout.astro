---
import '../styles/global.css';
import CookieConsent from '../components/ui/CookieConsent';
import { getLangFromUrl } from '../i18n/utils';
// import { ClerkProvider } from '@clerk/astro/components'; // Often handled by integration

interface Props {
  title: string;
  /** Language of the page content when it does not follow the URL (e.g. a public CV). */
  lang?: string;
  description?: string;
}

const { title, description = 'CV Builder' } = Astro.props;
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <CookieConsent lang={lang} client:load />
  </body>
</html>
