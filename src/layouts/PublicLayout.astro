---
import Layout from './Layout.astro';
import SiteHeader from '../components/ui/SiteHeader';
import { getLangFromUrl, useUiTranslations } from '../i18n/utils';
import { locales } from '../i18n/locales';

interface Props {
  title: string;
}

const { title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useUiTranslations(lang);
const recruiter = locales[lang].recruiter;
const recruitersUrl = `${lang === 'es' ? '' : `/${lang}`}/recruiters`;
---

<Layout title={title}>
  <SiteHeader lang={lang} client:only="react" />

  <div class="flex min-h-screen flex-col pt-16">
    <slot />
  </div>

  <footer class="mt-auto border-t border-white/10 bg-slate-900 py-8 text-center">
    <div class="container mx-auto px-4 text-sm text-slate-500">
      <p class="mb-3">
        {recruiter.ask}
        <a href={recruitersUrl} class="font-bold text-violet-300 hover:text-violet-200">
          {recruiter.askCta} →
        </a>
      </p>
      <p>
        &copy; {new Date().getFullYear()} CVStudio.tools. {t('footer.rights')}
      </p>
    </div>
  </footer>
</Layout>
